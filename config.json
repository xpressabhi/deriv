          "\\bkyc\\b",
          "\\bidentity\\s+(?:verification|review|check)\\b",
          "\\bid\\s+(?:document|documents|verification|check)\\b",
          "\\bdocuments?\\s+(?:approved|rejected|reviewed|verified)\\b",
