          "\\bpassword\\b[^.?!]{0,20}\\b(?:reset|set|changed|viewed|revealed|sent)\\b[^.?!]{0,15}\\b(?:for\\s+me|by\\s+(?:you|support|an?\\s+agent))\\b",
          "\\b(?:can|could|would)\\s+(?:you|support|an?\\s+agent)\\b[^.?!]{0,30}\\b(?:reset|set|change|view|see|reveal|tell|give|send|provide)\\b[^.?!]{0,20}\\bpassword\\b(?!\\s+(?:reset\\s+)?(?:email|link|instructions))",
          "\\bpassword\\b[^.?!]{0,15}\\bfor\\s+me\\b"
