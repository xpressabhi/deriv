    {
      "dot": "rose",
      "title": "Deterministic safety",
      "items": [
        "The gate runs in code before any draft is generated",
        "Verification is a separate deterministic stage",
        "The model never decides whether a prohibited guarantee is allowed"
      ]
    },
    {
      "dot": "cyan",
      "title": "Grounded generation",
      "items": [
        "Prompts contain only retrieved chunks plus the gate mode",
        "The model returns reply and used_chunk_ids as JSON",
        "An extractive generator covers offline and no-key runs"
      ]
    },
    {
      "dot": "emerald",
      "title": "Auditable and replayable",
      "items": [
        "Every stage writes structured artifacts for review",
        "llm_calls.jsonl logs prompt hashes, never prompts or keys",
        "Content hashes reuse tokenization and rebuild only changed chunks"
      ]
