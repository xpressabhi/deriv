# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# .env is gitignored and is never committed. The pipeline reads the first
# non-empty value it finds in this order:
#   OPENCODE_API_KEY, OPENCODE_GO_API_KEY, OPENCODE_ZEN_API_KEY

# Required for live model calls. Without a key the pipeline runs the
# deterministic extractive generator instead.
OPENCODE_API_KEY=your-opencode-go-key

# Optional overrides
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# SUPPORT_MODEL=deepseek-v4.1-flash
# SUPPORT_LLM_REQUIRED=0
